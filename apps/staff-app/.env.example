# Copy to `.env`. Both values are public — Expo inlines EXPO_PUBLIC_* into the
# bundle, so never put a secret here.
#
# Omit EXPO_PUBLIC_API_URL (or set EXPO_PUBLIC_USE_MOCK_API=true) to run the app
# on fixtures with no backend at all.
#
# On a physical phone, `localhost` is the PHONE. Use the deployed URL below, or
# your laptop's LAN address (e.g. http://192.168.1.5:8000/v1).
EXPO_PUBLIC_API_URL=https://api.tideover.site/v1
EXPO_PUBLIC_WS_URL=wss://api.tideover.site/v1
# EXPO_PUBLIC_USE_MOCK_API=true
