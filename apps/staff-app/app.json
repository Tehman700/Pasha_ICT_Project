{
  "expo": {
    "name": "Rukhsat Staff",
    "slug": "rukhsat-staff",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rukhsatstaff",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f7f4"
    },
    "android": {
      "package": "com.rukhsat.staff",
      "adaptiveIcon": {
        "backgroundColor": "#f7f7f4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "The guard app uses the camera only to scan pickup codes at the gate.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#f54e00"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37936b34-dd23-44ca-b4cb-72a533ece8f2"
      }
    },
    "owner": "tehman600",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/37936b34-dd23-44ca-b4cb-72a533ece8f2"
    },
    "ios": {}
  }
}
