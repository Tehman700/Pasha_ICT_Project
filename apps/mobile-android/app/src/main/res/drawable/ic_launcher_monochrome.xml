<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer. Same geometry as the foreground, flattened to a
  single colour, because that is what a monochrome layer is: the launcher
  tints it with the user's wallpaper palette and any colour baked in here
  fights that.

  The scaffold pointed <monochrome> straight at the coloured foreground, which
  is a common mistake - it makes the launcher render the icon through the
  themed path with the brand colours still in it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M41.88,34.7 L41.88,73.3"
        android:strokeColor="#000000"
        android:strokeWidth="8.08"
        android:strokeLineCap="round" />
    <path
        android:pathData="M66.12,34.7 L66.12,73.3"
        android:strokeColor="#000000"
        android:strokeWidth="8.08"
        android:strokeLineCap="round" />
    <path
        android:pathData="M34.7,54.45 L73.3,54.45"
        android:strokeColor="#000000"
        android:strokeWidth="8.08"
        android:strokeLineCap="round" />
</vector>
