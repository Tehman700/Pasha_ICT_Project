{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.tideover.site/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.tideover.site/v1"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.tideover.site/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.tideover.site/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
