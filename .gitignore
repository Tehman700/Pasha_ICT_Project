# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Node / Expo / Next.js
node_modules/
.expo/
.next/
dist/
build/
*.log
.turbo/

# Env & secrets
.env
.env.local
*.pem
keys/*
!keys/README.md

# Firebase.
#
# The service account can send push to every user of this system — it is a
# real secret and must never reach the repo.
fcm-service*.json

# `apps/*/google-services.json` IS committed, deliberately. It is not a secret
# — it ships inside the APK and anyone can unzip it — and EAS builds from a git
# archive, so an ignored file simply would not reach the build server. Push
# would then fail on a real device with no error anyone could trace.
# The two loose copies at the repo root are just the originals as downloaded.
/google-services-*.json

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Alembic bytecode
alembic/versions/__pycache__/

# Uploaded name-audio clips. These are runtime data, not source: production
# has its own on disk, and committing local test recordings would overwrite
# nothing while growing the repo with every demo.
backend/media/name-audio/*
!backend/media/name-audio/.gitkeep

# Built APKs. 50-100MB binaries that get rebuilt from source on every real
# change — committing one is a permanent, ever-growing entry in git history
# for a file nobody should ever diff. Uploaded directly to the server's
# downloads/ instead; deploy-backend.sh's `git reset --hard` never touches an
# untracked directory, so this survives every deploy.
backend/downloads/*
!backend/downloads/.gitkeep
