         style just controls the window background before the first frame. -->
    <style name="Base.Theme.MobileApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <style name="Theme.MobileApp" parent="Base.Theme.MobileApp" />
</resources>
