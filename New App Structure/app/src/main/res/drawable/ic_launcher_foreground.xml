<?xml version="1.0" encoding="utf-8"?>
<!-- Rukhsat mark, converted from App Logos/rukhsat-app-icon.svg.
     Circles become paths because VectorDrawable has no <circle> element.
     The 120-unit artwork sits inside the 108dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Departure arc -->
    <path
        android:pathData="M38,38 A60,60 0 0 0 82,82"
        android:strokeColor="#F6F7F4"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Origin ring -->
    <path
        android:pathData="M28.5,38 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0"
        android:strokeColor="#5B8BB8"
        android:strokeWidth="6.5" />

    <!-- Destination dot -->
    <path
        android:pathData="M71,82 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:fillColor="#E8A33D" />
</vector>
