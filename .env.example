# Copy to .env and fill in real values. Never commit .env itself.
#
# The defaults below match docker-compose.dev.yml, so a fresh clone works
# with no edits for local development.

# ── Backend ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://rukhsat_app:devpassword@localhost:5544/rukhsat
REDIS_URL=redis://localhost:6399/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_SECONDS=86400

QR_SIGNING_PRIVATE_KEY_PATH=./keys/qr_private.pem
QR_SIGNING_PUBLIC_KEY_PATH=./keys/qr_public.pem
# ES256 keypair — see backend/keys/README.md. Never commit the .pem files.

FCM_SERVICE_ACCOUNT_JSON_PATH=./keys/fcm-service-account.json

GEOFENCE_RADIUS_M=1000
# The classroom announcement fires on ETA, not on the geofence ring.
ANNOUNCE_ETA_SECONDS=120
# Foreground tracking auto-stops after this.
TRIP_MAX_MINUTES=90

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# ── Admin web (apps/admin-web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1

# ── Mobile apps ──────────────────────────────────────────────────────
# Expo only exposes vars prefixed EXPO_PUBLIC_ to the app bundle.
# For a phone on the same Wi-Fi, replace localhost with your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8000/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000/v1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME

# ── Deploy ───────────────────────────────────────────────────────────
# Set these as GitHub Actions repo secrets, NOT here:
# EC2_HOST, EC2_SSH_KEY, EC2_USER
