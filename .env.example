# Copy to .env and fill in real values. Never commit .env itself.
#
# The defaults below match docker-compose.dev.yml, so a fresh clone works
# with no edits for local development.

# ── Backend ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://rukhsat_app:devpassword@localhost:5544/rukhsat
REDIS_URL=redis://localhost:6399/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_SECONDS=86400

QR_SIGNING_PRIVATE_KEY_PATH=./keys/qr_private.pem
QR_SIGNING_PUBLIC_KEY_PATH=./keys/qr_public.pem
# ES256 keypair — see backend/keys/README.md. Never commit the .pem files.

FCM_SERVICE_ACCOUNT_JSON_PATH=./keys/fcm-service-account.json

GEOFENCE_RADIUS_M=1000
# The classroom announcement fires on ETA, not on the geofence ring.
ANNOUNCE_ETA_SECONDS=120
# Foreground tracking auto-stops after this.
TRIP_MAX_MINUTES=90

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# ── Admin web (apps/admin-web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1

# ── Mobile apps ──────────────────────────────────────────────────────
# Expo only exposes vars prefixed EXPO_PUBLIC_ to the app bundle.
# For a phone on the same Wi-Fi, replace localhost with your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8000/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000/v1

# ── Maps ─────────────────────────────────────────────────────────────
# Google Maps JavaScript API, for the dashboard's location picker. PUBLIC by
# necessity - it ships in the browser bundle. RESTRICT IT by HTTP referrer in
# Cloud Console, and note that Maps JS needs BILLING enabled on the project or
# it renders a darkened map stamped "For development purposes only".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME

# Search and routing deliberately do NOT use Google - only Maps JS is enabled
# on the project key - and deliberately do not use TomTom either. Measured
# against Pakistan, TomTom returned a Lahore school search result in
# Indian-administered Kashmir and could not route at all: 31 of 31 test routes
# across Lahore, Islamabad and Karachi declined. OpenStreetMap does both, and
# needs no key. See packages/shared/src/maps/osm.ts.

# Road distance for the queue ETA, called once per trip. Empty disables it and
# the ETA falls back to straight-line. The public OSRM demo below is fine for a
# demo and explicitly NOT for production load - self-host or use
# OpenRouteService before this carries real traffic.
ROUTING_BASE_URL=https://router.project-osrm.org

# ── Deploy ───────────────────────────────────────────────────────────
# Set these as GitHub Actions repo secrets, NOT here:
# EC2_HOST, EC2_SSH_KEY, EC2_USER
