# Copy to .env and fill in real values. Never commit .env itself.

# ── Shared / backend ─────────────────────────────────────────────
DATABASE_URL=postgresql://pickup_app:CHANGE_ME@<ec2-host>:5432/pickup
REDIS_URL=redis://<ec2-host>:6379/0

JWT_SECRET=CHANGE_ME
QR_SIGNING_PRIVATE_KEY_PATH=./keys/qr_private.pem
QR_SIGNING_PUBLIC_KEY_PATH=./keys/qr_public.pem
# ES256 keypair — see backend/keys/README.md for how to generate it.
# Never commit the actual .pem files.

FCM_SERVICE_ACCOUNT_JSON_PATH=./keys/fcm-service-account.json

GEOFENCE_RADIUS_M=1000

# ── Admin web (apps/admin-web) ───────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourschool-subdomain.com/v1
NEXT_PUBLIC_WS_URL=wss://api.yourschool-subdomain.com/v1

# ── Mobile apps (apps/parent-app, apps/staff-app) ────────────────
# Expo only exposes vars prefixed EXPO_PUBLIC_ to the app bundle.
EXPO_PUBLIC_API_URL=https://api.yourschool-subdomain.com/v1
EXPO_PUBLIC_WS_URL=wss://api.yourschool-subdomain.com/v1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME

# ── Deploy ────────────────────────────────────────────────────────
# Set these as GitHub Actions repo secrets, NOT here:
# EC2_HOST, EC2_SSH_KEY, EC2_USER
