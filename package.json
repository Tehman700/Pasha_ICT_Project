{
  "name": "school-pickup-system",
  "private": true,
  "version": "0.1.0",
  "description": "Smart School Pickup & Queue Management System — monorepo root",
  "scripts": {
    "dev:admin": "pnpm --filter @pickup/admin-web dev",
    "dev:parent": "pnpm --filter @pickup/parent-app start",
    "dev:staff": "pnpm --filter @pickup/staff-app start --port 8082",
    "build:admin": "pnpm --filter @pickup/admin-web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @pickup/shared test",
    "verify": "pnpm typecheck && pnpm test && pnpm build:admin"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "tsx": "^4.23.8"
  }
}
